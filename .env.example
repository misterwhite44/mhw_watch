# Réglages des sources de données de MHW Watch.
# Copie ce fichier en .env et modifie ce dont tu as besoin ; une ligne absente
# ou commentée garde sa valeur par défaut (celle indiquée ici).

# Ordre des sources essayées : erddap (rapide) puis psl (lent mais fiable).
MHW_WATCH_SOURCES=erddap,psl

# Serveurs ERDDAP qui servent OISST v2.1, essayés dans l'ordre (séparés par des virgules).
MHW_WATCH_ERDDAP_SERVERS=https://coastwatch.pfeg.noaa.gov/erddap,https://upwell.pfeg.noaa.gov/erddap
MHW_WATCH_ERDDAP_DATASET=ncdcOisst21Agg_LonPM180

# Serveur THREDDS/OPeNDAP de NOAA PSL (fichiers sst.day.mean.AAAA.nc).
MHW_WATCH_PSL_URL=https://psl.noaa.gov/thredds/dodsC/Datasets/noaa.oisst.v2.highres
# Jours par requête PSL (le serveur coupe au-delà d'environ 60 s, soit ~180 jours).
MHW_WATCH_PSL_DAYS=90
# Années téléchargées en parallèle sur PSL (au-delà de 2, PSL répond vite « 429 Too Many Requests »).
MHW_WATCH_PSL_WORKERS=2

# Délais réseau, en secondes, et nombre de nouvelles tentatives par serveur.
MHW_WATCH_CONNECT_TIMEOUT=10
MHW_WATCH_READ_TIMEOUT=180
MHW_WATCH_RETRIES=1

# Zone analysée pour chaque AMP : polygon (moyenne de la SST sur les mailles océan du
# contour WDPA) ou point (une seule maille, au point représentatif).
MHW_WATCH_AREA=polygon
# Région analysée par `mhw-watch analyze --site all` (voir `mhw-watch sites`) ; all = toutes.
MHW_WATCH_REGION=all
# Mailles moyennées au plus par AMP ; une grande AMP est sous-échantillonnée régulièrement.
MHW_WATCH_MAX_CELLS=40
# Service public d'UNEP-WCMC (ArcGIS REST) qui fournit les contours WDPA, sans clé d'API.
MHW_WATCH_WDPA_URL=https://data-gis.unep-wcmc.org/server/rest/services/ProtectedSites/The_World_Database_of_Protected_Areas/MapServer/1
